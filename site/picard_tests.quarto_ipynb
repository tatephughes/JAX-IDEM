{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Experiments with the Picard-map MCMC\"\n",
        "author: \"Evan Tate Paterson Hughes\"\n",
        "references:\n",
        "  - id: grazzi2025\n",
        "    type: article-journal\n",
        "    author:\n",
        "      - family: Grazzi\n",
        "        given: Sebastiano\n",
        "      - family: Zanella\n",
        "        given: Giacomo\n",
        "    title: \"Parallel computations for Metropolis Markov chains\"\n",
        "    issued:\n",
        "      year: 2025\n",
        "\n",
        "  - id: cabezas2024blackjax\n",
        "    type: article\n",
        "    title: \"BlackJAX: Composable Bayesian inference in JAX\"\n",
        "    author:\n",
        "      - family: Cabezas\n",
        "        given: Alberto\n",
        "      - family: Corenflos\n",
        "        given: Adrien\n",
        "      - family: Lao\n",
        "        given: Junpeng\n",
        "      - family: Louf\n",
        "        given: Rémi\n",
        "    issued:\n",
        "      year: 2024\n",
        "    archive: arXiv\n",
        "    eprint: 2402.10797\n",
        "    URL: https://arxiv.org/abs/2402.10797\n",
        "format:\n",
        "  html:\n",
        "    code-fold: true\n",
        "    toc: true\n",
        "    include-in-header: header.html\n",
        "    mathjax: \n",
        "      extensions: [\"breqn\", \"bm\", \"ams\"]\n",
        "---\n",
        "\n",
        "\n",
        "# Standard RMH\n",
        "\n",
        "Here is a very simple example of a RMH algorithm targetting a simple 2D Gaussian"
      ],
      "id": "ed327641"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import jax\n",
        "jax.config.update(\"jax_enable_x64\", True)\n",
        "import jax.numpy as jnp\n",
        "import jax.random as rand\n",
        "\n",
        "from jax.numpy.linalg import inv, outer\n",
        "\n",
        "import time\n",
        "\n",
        "from jax.scipy.stats.multivariate_normal import logpdf as logmvn\n",
        "from jax.random import multivariate_normal as smvn\n",
        "\n",
        "d = 100\n",
        "\n",
        "target_mean = jnp.ones(d)\n",
        "\n",
        "#target_cov = jnp.array([[1,0.5],[0.5,1]])\n",
        "key = jax.random.PRNGKey(seed=60)\n",
        "M = rand.normal(key, shape = (d,d))\n",
        "target_cov = M.T@M\n",
        "\n",
        "\n",
        "def log_target(state):\n",
        "    #useless_matrix = outer(state, state) + inv(10*jnp.identity(d))\n",
        "    #id = inv(useless_matrix) @ useless_matrix\n",
        "    return logmvn(state, target_mean, target_cov)\n",
        "\n",
        "init_state = jnp.ones(d)\n",
        "#prop_cov = jnp.eye(d)/jnp.sqrt(d)\n",
        "\n",
        "# Theoretically 'optimal'\n",
        "prop_cov = target_cov * (5.6644/d)\n",
        "\n",
        "\n",
        "import jaxidem.utils as utils\n",
        "#time_res = utils.time_jit(key, log_target, init_state, 1000)\n",
        "\n",
        "n = 1000\n",
        "\n",
        "@jax.jit\n",
        "def rmh_step(state, key):\n",
        "    prop_key, acc_key = jax.random.split(key, 2)\n",
        "\n",
        "    proposal = smvn(prop_key, state, prop_cov)\n",
        "    r = log_target(proposal) - log_target(state)\n",
        "\n",
        "    log_prob = jnp.minimum(0.0, r)\n",
        "\n",
        "    u = jax.random.uniform(acc_key)\n",
        "\n",
        "    new_state = jax.lax.cond((jnp.log(u) < log_prob),\n",
        "                             0, lambda _: proposal,\n",
        "                             0, lambda _: state)\n",
        "\n",
        "    return new_state, new_state\n",
        "\n",
        "\n",
        "\n",
        "key = jax.random.PRNGKey(42)\n",
        "# ensure compilation\n",
        "print(rmh_step(init_state, key)[0][0], flush=True)\n",
        "keys = jax.random.split(key, 2*n)\n",
        "\n",
        "start = time.time()\n",
        "_, chain_1 = jax.lax.scan(rmh_step, init_state, keys[:n])\n",
        "X_true = jnp.vstack([init_state, chain_1])\n",
        "end = time.time()\n",
        "\n",
        "seq_time = end-start\n",
        "\n",
        "print(f\"\\nStandard sequention RMH took {seq_time:.6f} seconds\")\n",
        "\n",
        "res_mean = jnp.mean(chain_1, axis=0)\n",
        "res_cov = jnp.cov(chain_1.T)\n",
        "\n",
        "#print(res_mean)\n",
        "#print(res_cov)\n",
        "\n",
        "accepted = jnp.any(X_true[1:] != X_true[:-1], axis=1)\n",
        "acceptance_rate = jnp.mean(accepted)\n",
        "print(f\"Acceptance rate is approximately: {100*acceptance_rate:6f}%.\")\n"
      ],
      "id": "f578692e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "x, y = X_true[:, 0], X_true[:, 1]\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "# Add trajectory line\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=x, y=y,\n",
        "    mode='lines+markers',\n",
        "    line=dict(color='blue'),\n",
        "    marker=dict(size=2),\n",
        "    name='Trajectory'\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[x[0]], y=[y[0]],\n",
        "    mode='markers',\n",
        "    marker=dict(size=10, color='green'),\n",
        "    name='Start'\n",
        "))\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[x[-1]], y=[y[-1]],\n",
        "    mode='markers',\n",
        "    marker=dict(size=10, color='red'),\n",
        "    name='End'\n",
        "))\n",
        "\n",
        "# Layout settings\n",
        "fig.update_layout(\n",
        "    title='RMH Trajectory (first 2 dimensions)',\n",
        "    xaxis_title='X_1',\n",
        "    yaxis_title='X_2',\n",
        "    showlegend=True,\n",
        "    width=700,\n",
        "    height=600\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "72889fb9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Picard Map\n",
        "\n",
        "General Markov chains on the domain $\\mathcal{X}$ can be written as\n",
        "\n",
        "$$\\begin{split}\n",
        "\\bv X_{i+1} = g(\\bv X_i, W_i),\\quad i=0,1,\\dots\n",
        "\\end{split}\n",
        "$${#eq-markov1}\n",
        "\n",
        "Where $X^{(0)}\\in\\mathcal{X}$ is fixed, $X^{(i)}\\in\\mathcal{X}$ and $W_i\\in\\mathcal{W}$ are random states (in JAX, the keys serve this purpose).\n",
        "\n",
        "We can rewrite @eq-markov1 as a random-step type markov chain form like so;\n",
        "\n",
        "$$\\begin{split} \n",
        "\\bv  X_{i+1} = \\bv X_{i} + \\underbrace{\\left(g(\\bv X_{i}, W_i) - \\bv X_{i}\\right)}_{f(\\bv X_{i}, W_i)}.\n",
        "\\end{split}\n",
        "$${#eq-markov2}\n",
        "\n",
        "This is now in the form used by @grazzi2025, so we can define the Picard map $\\Phi: \\mathcal{X}^{K+1}\\times\\mathcal{W}^K \\mapsto\\mathcal{X}^{K+1}$;\n",
        "\n",
        "$$\\begin{split}\n",
        "  \\bv X_{i}' = \\Phi_i(X_i, W) = \\begin{cases}\n",
        "\t\\bv X_0 &\\quad i=0\\\\ \n",
        "\t\\bv X_0 + \\sum_{l=0}^{i-1} f(X_l, W_l) &\\quad 0<i<K.\n",
        "\\end{cases}\n",
        "\\end{split}\n",
        "$${#eq-picard}\n",
        "\n",
        "\n",
        "Now we define a function that takes a particular step function $g(\\bv X_i,W_i)$ and gives the picard map corresponding to $f(\\bv X_i,W_i) = g(\\bv X_i, W_i) - \\bv X_i$."
      ],
      "id": "af140994"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def get_picard_map(step):\n",
        "    # vectorise the step function\n",
        "    vf = jax.vmap(lambda s, key: step(s, key)[0] - s)\n",
        "\n",
        "    @jax.jit\n",
        "    def picard_map(states, keys):\n",
        "        init_state = states[0]        \n",
        "        fs = vf(states[0:-1], keys)\n",
        "        cumsum = init_state + jnp.cumsum(fs, axis=0)\n",
        "        return jnp.vstack([init_state, cumsum])\n",
        "    return picard_map"
      ],
      "id": "93217aa8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "Now we define a new function to apply the map only to a section of the chain, and return the index to which the chain has already converged.\n",
        "\n",
        "# JIT-Luc Picard"
      ],
      "id": "f26095b1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def jit_luc(pic_map, K, keys): \n",
        "\n",
        "    @jax.jit\n",
        "    def online_step(tup):\n",
        "\n",
        "        states, L, i = tup\n",
        "        \n",
        "        d = states.shape[1]\n",
        "\n",
        "        states_to_update = jax.lax.dynamic_slice(states, (L,0), (K, d))\n",
        "        keys_to_update_with = jax.lax.dynamic_slice(keys, (L,0), (K-1, 2))\n",
        "        \n",
        "        updated_states = pic_map(states_to_update, keys_to_update_with)\n",
        "\n",
        "        states_new = jax.lax.dynamic_update_slice(states, updated_states, (L,0))\n",
        "\n",
        "        states_incorrect = jnp.all(states_to_update != updated_states, axis=1)\n",
        "\n",
        "        L_new = L + jnp.where(states_incorrect, size=1, fill_value=K-1)[0][0]\n",
        "        \n",
        "        return states_new, L_new, i+1\n",
        "    \n",
        "    return online_step\n",
        "\n",
        "\n",
        "pic_map = get_picard_map(rmh_step)\n",
        "\n",
        "K = 10\n",
        "X_0 = jnp.stack([init_state for _ in range(n+K+1)])\n",
        "\n",
        "\n",
        "jit_step = jit_luc(pic_map, K, keys)\n",
        "\n",
        "L = 0\n",
        "init_val = (X_0, jnp.array(L), 0)\n",
        "\n",
        "start = time.time()\n",
        "X_final, L, iterations = jax.lax.while_loop(lambda val: val[1]<n, jit_step, init_val)\n",
        "end = time.time()\n",
        "\n",
        "jitpar_time = end-start\n",
        "\n",
        "print(f\"Converge Success: {jnp.allclose(X_final[:n+1], X_true)}, in {iterations} iterations\")\n",
        "\n",
        "print(f\"\\nJitted Online-Picard accelerated RMH took {jitpar_time:.6f} seconds\")\n",
        "\n",
        "print(f\"\\nStandard sequential RMH took {seq_time:.6f} seconds\")"
      ],
      "id": "fc6c6ed9",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Optimal K\n",
        "\n",
        "I'm actually now interested in the optimal value for K. Assuming each markov step can only be done by one core at a time, the optimal K is probably simply the number of cores that the machine has, since that will exactly saturate the cpu. \n",
        "But here, with JAX, we mostly trust JAX to parallelise things, as a result, each RMH step is already trying to saturate the CPU (check htop).\n",
        "\n",
        "This means that only so much more parallelisation can be added before we lose benefits, even for K below the number of cores.\n",
        "This matters because we don't want to waste computation; if, during an online step, the algorithm finds that only, for example, the first 3 indices match, but K=10 so that 10 states are updates, then the last 7 computations where wasted, so K=3 would have been better.\n",
        "\n",
        "So there is, presumably, an optimal K. \n",
        "I would postulate that the optimal K depends directly on the number of CPU cores _as well as_ the acceptance rate; a lower acceptance rate means that more steps can be 'skipped', and so more indices match at each step, so ideally K would be exactly this number of indices. \n",
        "Since we probably dont want to eveluate the picard map up to an arbitrary point (at with the new states mismatch the last step), since that would make parallelism less obvious, K likely relates to either the average number of times that the chain rejects in a row, or perhaps the maximum number of times, for finite chains.\n",
        "\n",
        "For the chain above, lets get the computation time and number of iterations for K=2,...,10.\n",
        "\n",
        "(note that, in my implementation, theres a bit of a quirk; K-1 steps are actually computed at once, as opposed to K.)\n"
      ],
      "id": "aec6aec3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "Ks = list(range(2,20))\n",
        "\n",
        "times = []\n",
        "iterations = []\n",
        "success = []\n",
        "\n",
        "pic_map = get_picard_map(rmh_step)\n",
        "\n",
        "for K in Ks:\n",
        "    \n",
        "    jit_step = jit_luc(pic_map, K, keys)\n",
        "\n",
        "    X_0 = jnp.stack([init_state for _ in range(n+1+K)])\n",
        "\n",
        "    L = 0\n",
        "    init_val = (X_0, L, 0)\n",
        "\n",
        "    start = time.time()\n",
        "    X_final, L, i = jax.lax.while_loop(lambda val: val[1]<n, jit_step, init_val)\n",
        "    end = time.time()\n",
        "    \n",
        "    success.append(jnp.allclose(X_final[:n+1], X_true))\n",
        "    iterations.append(i)\n",
        "\n",
        "    par_time = end-start\n",
        "    times.append(par_time)\n",
        "\n",
        "# Marker colors\n",
        "colors = ['green' if s else 'red' for s in success]\n",
        "\n",
        "# Main trace\n",
        "trace = go.Scatter(\n",
        "    x=Ks,\n",
        "    y=times,\n",
        "    mode='lines+markers+text',\n",
        "    text=[f\"{i}\" for i in iterations],\n",
        "    textposition='top center',\n",
        "    marker=dict(size=10, color=colors, line=dict(width=1, color='black')),\n",
        "    line=dict(color='gray')\n",
        ")\n",
        "\n",
        "# Baseline shape: horizontal dotted line\n",
        "baseline_line = dict(\n",
        "    type='line',\n",
        "    xref='x',\n",
        "    yref='y',\n",
        "    x0=min(Ks),\n",
        "    x1=max(Ks),\n",
        "    y0=seq_time,\n",
        "    y1=seq_time,\n",
        "    line=dict(color='blue', width=2, dash='dot')\n",
        ")\n",
        "\n",
        "# Build figure\n",
        "fig = go.Figure(data=[trace])\n",
        "fig.update_layout(\n",
        "    title=\"Algorithm Evaluation Time vs K\",\n",
        "    xaxis_title=\"K\",\n",
        "    yaxis_title=\"Evaluation Time (s)\",\n",
        "    yaxis=dict(range=[0, max([max(times), seq_time])*1.1]),\n",
        "    shapes=[baseline_line],\n",
        "    template=\"plotly_white\"\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "0d63b12e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The blue line is the time the sequential algorithm took. As can be seen, the algorithm never seems to get better than the sequential time.\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "# Quick alternative"
      ],
      "id": "f87fada2"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@jax.jit\n",
        "def f(state, key):\n",
        "    prop_key, acc_key = jax.random.split(key, 2)\n",
        "\n",
        "    proposal = smvn(prop_key, state, prop_cov)\n",
        "    r = log_target(proposal) - log_target(state)\n",
        "\n",
        "    log_prob = jnp.minimum(0.0, r)\n",
        "\n",
        "    u = jax.random.uniform(acc_key)\n",
        "\n",
        "    accepted = jnp.log(u) < log_prob\n",
        "\n",
        "    new_state = jax.lax.cond(accepted,\n",
        "                             0, lambda _: proposal,\n",
        "                             0, lambda _: state)\n",
        "\n",
        "    return new_state - state, accepted\n",
        "\n",
        "def jit_luc_tng(f, K, keys):\n",
        "    \n",
        "    vf = jax.vmap(lambda s, key: f(s, key))\n",
        "\n",
        "    @jax.jit\n",
        "    def online_step(tup):\n",
        "\n",
        "        states, L, i = tup\n",
        "        \n",
        "        d = states.shape[1]\n",
        "\n",
        "        states_to_update = jax.lax.dynamic_slice(states, (L,0), (K, d))\n",
        "        keys_to_update_with = jax.lax.dynamic_slice(keys, (L,0), (K-1, 2))\n",
        "\n",
        "        init_state = states_to_update[0]        \n",
        "        fs, accepted = vf(states_to_update[0:-1], keys_to_update_with)\n",
        "        updated_states = init_state + jnp.cumsum(fs, axis=0)\n",
        "\n",
        "        states_new = jax.lax.dynamic_update_slice(states, updated_states, (L+1,0))\n",
        "\n",
        "        states_incorrect = jnp.all(states_to_update[1:] != updated_states, axis=1)\n",
        "\n",
        "        L_new = L + jnp.where(states_incorrect, size=1, fill_value=K-1)[0][0] + 1\n",
        "        \n",
        "        return states_new, L_new, i+1\n",
        "    \n",
        "    return online_step\n",
        "\n",
        "K = 10\n",
        "X_0 = jnp.stack([init_state for _ in range(n+K+1)])\n",
        "jit_step = jit_luc_tng(f, K, keys)\n",
        "\n",
        "L = 0\n",
        "init_val = (X_0, L, 0)\n",
        "\n",
        "start = time.time()\n",
        "X_final, L, iterations = jax.lax.while_loop(lambda val: val[1]<n, jit_step, init_val)\n",
        "end = time.time()\n",
        "\n",
        "jitpar2_time = end-start\n",
        "\n",
        "print(f\"Converge Success: {jnp.allclose(X_final[:n+1], X_true)}, in {iterations} iterations\")\n",
        "\n",
        "print(f\"\\nJitted Online-Picard accelerated RMH took {jitpar_time:.6f} seconds\")\n",
        "\n",
        "print(f\"\\nJitted Online-Picard 2 accelerated RMH took {jitpar2_time:.6f} seconds\")\n",
        "\n",
        "print(f\"\\nStandard sequential RMH took {seq_time:.6f} seconds\")\n"
      ],
      "id": "ff587ea6",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Varying Acceptance Rates\n"
      ],
      "id": "15ef85f6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import jax\n",
        "import jax.numpy as jnp\n",
        "\n",
        "\n",
        "df = pd.read_csv('data/acceptance_results.csv')\n",
        "\n",
        "success = jnp.array(df['success'])\n",
        "\n",
        "if not jnp.all(success):\n",
        "\n",
        "    print(\"Failed cases found. Removing corresponding rows and continuing, but this mean that there is likely something quite wrong.\")\n",
        "    df = df[df['success'] == True]\n",
        "\n",
        "df_avg = df.groupby(['prop_scale', 'K'], as_index=False).mean()\n",
        "df_avg = df_avg.drop(columns=['j', 'success'])"
      ],
      "id": "33a3ca55",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import plotly.express as px\n",
        "import pandas as pd\n",
        "\n",
        "# Assuming df_avg is your aggregated DataFrame\n",
        "df_melted = df_avg.melt(\n",
        "    id_vars=['prop_scale', 'K', 'acceptance_rate', 'iterations'],\n",
        "    value_vars=['par_time', 'seq_time'],\n",
        "    var_name='TimeType',\n",
        "    value_name='TimeValue'\n",
        ")\n",
        "\n",
        "df_melted['text'] = df_melted.apply(\n",
        "    lambda row: str(row['iterations']) if row['TimeType'] == 'par_time' else '',\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "\n",
        "fig = px.line(\n",
        "    df_melted,\n",
        "    x='acceptance_rate',\n",
        "    y='TimeValue',\n",
        "    color='TimeType',\n",
        "    color_discrete_map={'par_time': 'blue', 'seq_time': 'red'},\n",
        "    facet_col='K',\n",
        "    text='text',\n",
        "    markers=True  # Add markers to make the text labels clearer\n",
        ")\n",
        "\n",
        "fig.update_traces(textposition='top center')\n",
        "fig.update_layout(title='Time vs Acceptance Rate by K', height=500)\n",
        "fig.show()\n"
      ],
      "id": "b578428a",
      "execution_count": null,
      "outputs": []
    }
  ],
