        "Let's make a new model which we will fit to the truth;"
      ],
      "id": "0b553b51"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "model_0 = idem.init_model(obs_data,\n",
        "                          basis_type = 'bisquare',\n",
        "                          basis_args=[1, 4], # 1 resolution 4x4 knots\n",
        "                          k_spat_inv = True)\n",
        "\n",
        "idem.print_params(model_0.params)"
      ],
      "id": "7fc35f9f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "In this case, the only parameters that are wrong are the offsets; the direction of flow, and the variances.\n",
        "\n",
        "In this example, we'll use a strong prior on the shape, scale, and beta; in practical examples, a strong prior on shape and scale, perhaps around the MLE, is usually a good idea."
      ],
      "id": "fced7c45"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "true_params = true_model.params\n",
        "\n",
        "def log_prior(params):\n",
        "    return (-0.5*(params.trans_kernel_params[0] - true_params.trans_kernel_params[0])**2/0.1**2\n",
        "            -0.5*(params.trans_kernel_params[1] - true_params.trans_kernel_params[1])**2/0.1**2\n",
        "#            -0.5*(params.trans_kernel_params[2] - 0.0)**2/3**2\n",
        "#            -0.5*(params.trans_kernel_params[3] - 0.0)**2/3**2\n",
        "            -0.5*(params.beta - true_params.beta)**2/0.1**2)[0]"
      ],
      "id": "1de1530e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "We can now get the marginal log-likelihood, and construct the log posterior"
      ],
      "id": "822fb249"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "log_marginal = model_0.get_log_like(obs_data, method=\"sqinf\", likelihood='partial')\n",
        "\n",
        "\n",
        "def log_post(params): return log_prior(params) + log_marginal(params)"
      ],
      "id": "cac8f383",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "We can know do with this anything; for example, here is a NUTS chain from BLACKJAX"
      ],
      "id": "fc70dc90"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "rng_key = jax.random.PRNGKey(42)\n",
        "\n",
        "import blackjax\n",
        "\n",
        "step_size = 1e-2\n",
        "imm = jnp.ones(model_0.nparams)\n",
        "\n",
        "nuts = blackjax.nuts(log_post, step_size, imm)\n",
        "\n",
        "init_nuts_state = nuts.init(model_0.params)\n",
        "\n",
        "def nuts_step(state, key):\n",
        "    new_state,_ = nuts.step(key, state)\n",
        "    return new_state, new_state\n",
        "\n",
        "n = 50\n",
        "keys = jax.random.split(rng_key, n)\n",
        "\n",
        "_, chain = jax.lax.scan(nuts_step, init_nuts_state, keys)"
      ],
      "id": "a2fc43ad",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "We can extract the offset parameters like so, and make a trajectory plot from them;"
      ],
      "id": "a2de5762"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "offset_sample = jnp.hstack(chain.position.trans_kernel_params[2:])\n",
        "\n",
        "res_mean = jnp.mean(offset_sample, axis=0)\n",
        "res_cov = jnp.cov(offset_sample.T)\n",
        "\n",
        "\n",
        "print(res_mean)\n",
        "print(res_cov)"
      ],
      "id": "27e0d267",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| code-fold: true\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "x, y = offset_sample[:, 0], offset_sample[:, 1]\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "# Add trajectory line\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=x, y=y,\n",
        "    mode='lines+markers',\n",
        "    line=dict(color='blue'),\n",
        "    marker=dict(size=2),\n",
        "    name='Trajectory'\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[x[0]], y=[y[0]],\n",
        "    mode='markers',\n",
        "    marker=dict(size=10, color='green'),\n",
        "    name='Start'\n",
        "))\n",
        "\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[-0.1], y=[0.1],\n",
        "    mode='markers',\n",
        "    marker=dict(size=10, color='yellow'),\n",
        "    name='Truth'\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=[x[-1]], y=[y[-1]],\n",
        "    mode='markers',\n",
        "    marker=dict(size=10, color='red'),\n",
        "    name='End'\n",
        "))\n",
        "\n",
        "# Layout settings\n",
        "fig.update_layout(\n",
        "    title='HMC Trajectory (64 bit)',\n",
        "    xaxis_title='X_1',\n",
        "    yaxis_title='X_2',\n",
        "    showlegend=True,\n",
        "    width=700,\n",
        "    height=600\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "1b5f3e4e",
      "execution_count": null,
      "outputs": []
    }
