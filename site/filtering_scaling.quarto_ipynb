        "fig.add_trace(go.Scatter(\n",
        "    x=m_x,\n",
        "    y=m_y,\n",
        "    mode='lines',\n",
        "    name='Filtered mean',\n",
        "    line=dict(color=cat[\"yellow\"], width=2)\n",
        "))\n",
        "\n",
        "# Uncertainty band (±1 std) for filtered position\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=jnp.concatenate([m_x - jnp.sqrt(s2_x), m_x[::-1] + jnp.sqrt(s2_x[::-1])]),\n",
        "    y=jnp.concatenate([m_y - jnp.sqrt(s2_y), m_y[::-1] + jnp.sqrt(s2_y[::-1])]),\n",
        "    fill='toself',\n",
