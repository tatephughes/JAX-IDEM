    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Filters with Likelihood computation\n",
        "\n",
        "## Standard Kalman Filter"
      ],
      "id": "b41b2c02"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from jax.scipy.linalg import solve_triangular as st\n",
        "\n",
        "@jax.jit\n",
        "def kalman_filter(m_0, P_0, M, PHI, S2_eta, S2_eps, zs):\n",
        "\n",
        "    r = m_0.shape[0]\n",
        "    nobs = zs.shape[1]\n",
        "    \n",
        "    @jax.jit\n",
        "    def step(carry, z_t):\n",
        "        m_tt, P_tt, _, _, ll = carry\n",
        "\n",
        "        # predict\n",
        "        m_pred = M @ m_tt\n",
        "        P_pred = M @ P_tt @ M.T + S2_eta\n",
        "        # Update\n",
        "        e_t = z_t - PHI @ m_pred\n",
        "        Sigma_t = PHI @ P_pred @ PHI.T + S2_eps\n",
        "        K_t = (jsc.linalg.solve(Sigma_t, PHI, assume_a = \"pos\") @ P_pred.T).T \n",
        "        \n",
        "        m_up = m_pred + K_t @ e_t\n",
        "        P_up = (jnp.eye(r) - K_t @ PHI) @ P_pred\n",
        "        \n",
        "        # Stabilised form\n",
        "        # P_up = (jnp.eye(r) - K_t @ PHI) @ P_pred @ (jnp.eye(r) - K_t @ PHI).T + K_t@S2_eps@K_t.T\n",
        "\n",
        "        # likelihood of epsilon, using cholesky decomposition\n",
        "        chol_Sigma_t = jnp.linalg.cholesky(Sigma_t)\n",
        "        z = st(chol_Sigma_t, e_t, lower=True)\n",
        "        ll_new = (\n",
        "            ll\n",
        "            - jnp.sum(jnp.log(jnp.diag(chol_Sigma_t)))\n",
        "            - 0.5 * jnp.dot(z, z)\n",
        "            - 0.5 * nobs * jnp.log(2 * jnp.pi)\n",
        "        )\n",
        "\n",
        "        new_carry = (m_up, P_up, m_pred, P_pred, ll_new)\n",
        "        return new_carry, new_carry\n",
        "\n",
        "\n",
        "    carry, seq = jl.scan(\n",
        "        step,\n",
        "        (m_0, P_0, m_0, P_0, 0),\n",
        "        zs,\n",
        "    )\n",
        "\n",
        "    ll, ms, Ps, mpreds, Ppreds = (carry[4], seq[0], seq[1], seq[2], seq[3])\n",
        "    \n",
        "    filt_results = {\"ll\": ll,\n",
        "                    \"ms\": ms,\n",
        "                    \"Ps\": Ps,\n",
        "                    \"mpreds\": mpreds,\n",
        "                    \"Ppreds\": Ppreds}\n",
        "\n",
        "    return filt_results"
      ],
      "id": "ffa8bb72",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "m_0 = jnp.zeros(4)\n",
        "P_0 = 100*jnp.eye(4)\n",
        "\n",
        "filt_results_kal = kalman_filter(m_0, P_0, M, PHI, S2_eta, S2_eps, zs)\n",
        "\n",
        "print(f\"Log-Likelihood = {filt_results_kal['ll']}\")"
      ],
      "id": "da066c17",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
