        "}\n",
        "\n",
        "for T in T_vals:\n",
        "    zs_cut = zs[:T, :]\n",
        "    inp_tree = (M, PHI, S2_eta, S2_eps, zs_cut)\n",
        "    results[\"kal\"].append(time_jit(key, jit_kal, inp_tree, n=nreps).average_time * 1000)\n",
        "    results[\"inf\"].append(time_jit(key, jit_inf, inp_tree, n=nreps).average_time * 1000)\n",
        "    results[\"sqrt\"].append(time_jit(key, jit_sqrt, inp_tree, n=nreps).average_time * 1000)\n",
        "    results[\"sqinf\"].append(time_jit(key, jit_sqinf, inp_tree, n=nreps).average_time * 1000)\n",
        "    results[\"pkal\"].append(time_jit(key, jit_pkal, inp_tree, n=nreps).average_time * 1000)\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "for method, times in results.items():\n",
