      "source": [
        "#| eval: true\n",
        "\n",
        "m_0 = jnp.zeros(nbasis)\n",
        "P_0 = 100*jnp.eye(nbasis)\n",
        "U_0 = jnp.linalg.cholesky(P_0)\n",
        "\n",
        "nu_0 = jnp.zeros(nbasis)\n",
        "Q_0 = 0.01*jnp.eye(nbasis)\n",
        "R_0 = jnp.linalg.cholesky(Q_0)\n",
        "\n",
        "jit_kal   = lambda tup: kalman_filter(m_0, P_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_inf   = lambda tup: information_filter(nu_0, Q_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_sqrt  = lambda tup: sqrt_filter(m_0, U_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_sqinf = lambda tup: sqinf_filter(nu_0, R_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_pkal  = lambda tup: pkalman_filter(m_0, P_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "\n",
        "inp_tree = (M, PHI, S2_eta, S2_eps, zs)\n",
        "time_kal_gpu   = time_jit(key, jit_kal, inp_tree, n=1)\n",
        "time_inf_gpu   = time_jit(key, jit_inf, inp_tree, n=1)\n",
        "time_sqrt_gpu  = time_jit(key, jit_sqrt, inp_tree, n=1)\n",
        "time_sqinf_gpu = time_jit(key, jit_sqinf, inp_tree, n=1)\n",
        "time_pkal_gpu  = time_jit(key, jit_pkal, inp_tree, n=1)\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "data = [\n",
        "    [\"kal\", \"GPU\", time_kal_gpu.compile_time, time_kal_gpu.average_time * 1000, time_kal_gpu.value],\n",
        "    [\"inf\", \"GPU\", time_inf_gpu.compile_time, time_inf_gpu.average_time * 1000, time_inf_gpu.value],\n",
        "    [\"sqrt\", \"GPU\", time_sqrt_gpu.compile_time, time_sqrt_gpu.average_time * 1000, time_sqrt_gpu.value],\n",
        "    [\"sqinf\", \"GPU\", time_sqinf_gpu.compile_time, time_sqinf_gpu.average_time * 1000, time_sqinf_gpu.value],\n",
        "    [\"pkal\", \"GPU\", time_pkal_gpu.compile_time, time_pkal_gpu.average_time * 1000, time_pkal_gpu.value],\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(data, columns=[\"Method\", \"Device\", \"Compile Time (s)\", \"Average Time (ms)\", \"Log Likelihood\"])"
      ],
