    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Square-root filter"
      ],
      "id": "e49b411a"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@jax.jit\n",
        "def qr_R(A, B):\n",
        "    \"\"\"Wrapper for the stacked-QR decompositon\"\"\"\n",
        "    return jnp.linalg.qr(jnp.vstack([A, B]), mode=\"r\")\n",
        "\n",
        "@jax.jit\n",
        "def sqrt_filter(m_0, U_0, M, PHI, S2_eta, S2_eps, zs):\n",
        "\n",
        "    r = m_0.shape[0]\n",
        "    nobs = zs.shape[1]\n",
        "\n",
        "    S_eta = jnp.linalg.cholesky(S2_eta, upper=True)\n",
        "    S_eps = jnp.linalg.cholesky(S2_eps, upper=True)\n",
        "\n",
        "    @jax.jit\n",
        "    def step(carry, z_t):\n",
        "        m_tt, U_tt, _, _, ll= carry\n",
        "\n",
        "        # predict\n",
        "        m_pred = M @ m_tt\n",
        "        U_pred = qr_R(U_tt @ M.T, S_eta)\n",
        "        #U_pred = jnp.linalg.cholesky(M @ U_tt.T @U_tt @ M.T + S2_eta, upper=True)\n",
        "        # Update\n",
        "        e_t = z_t - PHI @ m_pred\n",
        "        Ui_t = qr_R(U_pred @ PHI.T, S_eps)\n",
        "        #Ui_t = jnp.linalg.cholesky(PHI @ U_pred.T@U_pred @ PHI.T + S2_eps, upper=True)\n",
        "\n",
        "        # Kalman Gain2\n",
        "        K_t =(\n",
        "            st(\n",
        "                Ui_t,\n",
        "                st(Ui_t.T, PHI, lower=True)\n",
        "                @ U_pred.T\n",
        "                @ U_pred,\n",
        "            )\n",
        "        ).T\n",
        "\n",
        "        m_up = m_pred + K_t @ e_t\n",
        "\n",
        "        U_up = qr_R(U_pred @ (jnp.eye(r) - K_t @ PHI).T, S_eps @ K_t.T)\n",
        "        s = st(Ui_t.T, e_t, lower=True)\n",
        " \n",
        "        ll_new = (ll\n",
        "                  - jnp.sum(jnp.log(jnp.abs(jnp.diag(Ui_t))))\n",
        "                  - 0.5 * jnp.dot(s, s)\n",
        "                  - 0.5 * nobs * jnp.log(2 * jnp.pi)\n",
        "                  )\n",
        "\n",
        "        new_carry = (m_up, U_up, m_pred, U_pred, ll_new)\n",
        "        return new_carry, new_carry\n",
        "\n",
        "    carry, seq = jl.scan(\n",
        "        step,\n",
        "        (m_0, U_0, m_0, U_0, 0),\n",
        "        zs,\n",
        "    )\n",
        "\n",
        "    ll, ms, Us, mpreds, Upreds = (carry[4], seq[0], seq[1], seq[2], seq[3])\n",
        "\n",
        "    filt_results = {\"ll\": ll,\n",
        "                    \"ms\": ms,\n",
        "                    \"Us\": Us,\n",
        "                    \"mpreds\": mpreds,\n",
        "                    \"Upreds\": Upreds,}\n",
        "\n",
        "    return filt_results"
      ],
      "id": "b4d1ce71",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "U_0 = jnp.linalg.cholesky(P_0)\n",
        "\n",
        "filt_results_sqrt = sqrt_filter(m_0, U_0, M, PHI, S2_eta, S2_eps, zs)\n",
        "\n",
        "print(f\"Log-Likelihood = {filt_results_sqrt['ll']}\")"
      ],
      "id": "fba8d0bd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Sqrt-information filter"
      ],
      "id": "ad3d7ac4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@jax.jit\n",
        "def ql_L(A, B):\n",
        "    \"\"\"Wrapper for the stacked-QL decompositon\"\"\"\n",
        "    A_flipped = jnp.flip(jnp.vstack([A, B]), axis=1)\n",
        "    R = jnp.linalg.qr(A_flipped, mode='r')\n",
        "    L = jnp.flip(R, axis=(0, 1))\n",
        "\n",
        "    return L\n",
        "\n",
        "\n",
        "def safe_cholesky(matrix):\n",
        "    def zero_case(_):\n",
        "        return jnp.zeros_like(matrix)\n",
        "    def nonzero_case(matrix):\n",
        "        return jnp.linalg.cholesky(matrix, upper=True)\n",
        "    return jax.lax.cond(\n",
        "        jnp.all(matrix == 0),\n",
        "        zero_case,\n",
        "        nonzero_case,\n",
        "        operand=matrix\n",
        "        )\n",
        "\n",
        "\n",
        "@jax.jit\n",
        "def sqinf_filter(nu_0, R_0, M, PHI, S2_eta, S2_eps, zs):\n",
        "\n",
        "    r = nu_0.shape[0]\n",
        "    nobs = zs.shape[1]\n",
        "\n",
        "    S_eps, _ = jsc.linalg.cho_factor(S2_eps, lower = False)\n",
        "    S_eta, _ = jsc.linalg.cho_factor(S2_eta, lower = False)\n",
        "\n",
        "    # pretty quick\n",
        "    i_ts = jax.vmap(lambda z: PHI.T @ jsc.linalg.cho_solve((S_eps, True), z), in_axes=0)(zs)\n",
        "    R = jnp.linalg.qr(st(S_eps.T, PHI, lower=False), mode=\"r\")\n",
        "    #R = safe_cholesky(PHI.T @ jsc.linalg.cho_solve((S_eps, True), PHI))\n",
        "\n",
        "    @jax.jit\n",
        "    def step(carry, i):\n",
        "        nu_tt, R_tt, _, _ = carry\n",
        "\n",
        "        U_pred = ql_L(st(R_tt.T, M.T, lower=True), S_eta)\n",
        "        R_pred = st(U_pred, jnp.eye(r), lower=True).T\n",
        "        nu_pred = R_pred.T @ R_pred @ M @ st(R_tt,\n",
        "                                             st(R_tt.T,\n",
        "                                                nu_tt,\n",
        "                                                lower=True), lower=False)\n",
        "\n",
        "        nu_up = nu_pred + i\n",
        "        R_up = qr_R(R_pred, R)\n",
        "        #R_up = jnp.linalg.cholesky(R_pred.T @R_pred + R.T@R, upper=True)\n",
        "\n",
        "        new_carry = (nu_up, R_up, nu_pred, R_pred)\n",
        "        return new_carry, new_carry\n",
        "\n",
        "    # also pretty quick\n",
        "    carry, seq = jl.scan(\n",
        "        step,\n",
        "        (nu_0, R_0, jnp.zeros(r), jnp.eye(r)),\n",
        "        i_ts,\n",
        "    )\n",
        "\n",
        "    nus, Rs, nupreds, Rpreds = (seq[0], seq[1], seq[2], seq[3])\n",
        "\n",
        "    # THIS is where slowdown happens. why?\n",
        "    def likelihood_func(z, nu_pred, R_pred):\n",
        "                    \n",
        "        e = z - PHI @ st(R_pred, st(R_pred.T, nu_pred, lower=True), lower=False)\n",
        "\n",
        "        # IS IT THE qr_Rs fault????\n",
        "        #Ui_t = qr_R(st(R_pred.T, PHI.T, lower=True), S_eps)\n",
        "        Ui_t = jnp.linalg.cholesky(PHI @ st(R_pred, st(R_pred.T, PHI.T, lower=True)) + S2_eps)\n",
        "        s = st(Ui_t, e, lower=True)\n",
        "\n",
        "        ll = (\n",
        "            - jnp.sum(jnp.log(jnp.abs(jnp.diag(Ui_t))))\n",
        "            - 0.5 * jnp.dot(s, s)\n",
        "            - 0.5 * nobs * jnp.log(2 * jnp.pi)\n",
        "        )\n",
        "        \n",
        "        return ll\n",
        "        \n",
        "    lls = jax.vmap(likelihood_func)(zs, nupreds, Rpreds)\n",
        "    ll = jnp.sum(lls)\n",
        "    \n",
        "\n",
        "    filt_results = {\"ll\": ll,\n",
        "                    \"nus\": nus,\n",
        "                    \"Rs\": Rs,\n",
        "                    \"nupreds\": nupreds,\n",
        "                    \"Rpreds\": Rpreds}\n",
        "    \n",
        "    return filt_results"
      ],
      "id": "0d270afb",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "R_0 = jnp.linalg.cholesky(Q_0)\n",
        "#R_0 = jnp.zeros((4,4))\n",
        "\n",
        "filt_results_sqinf = sqinf_filter(nu_0, R_0, M, PHI, S2_eta, S2_eps, zs)\n",
        "\n",
        "print(f\"Log-Likelihood = {filt_results_sqinf['ll']}\")"
