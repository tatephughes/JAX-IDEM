    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Parallel Filter\n"
      ],
      "id": "a2c0eaa6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@jax.jit\n",
        "def pkalman_filter(m_0, P_0, M, PHI, S2_eta, S2_eps, zs):\n",
        "    \n",
        "    r = m_0.shape[0]\n",
        "    nobs = zs.shape[1]\n",
        "\n",
        "    m1pred = M @ m_0\n",
        "    P1pred = M @ P_0 @ M.T + S2_eta\n",
        "\n",
        "    S_1 =  PHI @ P1pred @ PHI.T + S2_eps\n",
        "\n",
        "    # cholS = jsc.linalg.cho_factor(S_1)\n",
        "    #D_1 = (jsc.linalg.cho_solve(cholS, PHI_tree[0])@P1pred.T).T\n",
        "\n",
        "    D_1 = (jnp.linalg.solve(S_1, PHI @ P1pred)).T\n",
        "    \n",
        "    A_1  = jnp.zeros((r,r))\n",
        "    b_1  = m1pred + D_1 @ (zs[0] - PHI @ m1pred)\n",
        "    C_1  = P1pred - D_1 @ S_1 @ D_1.T\n",
        "\n",
        "    # this is how it is in the paper. Adrien Corenflos has a slighlty different\n",
        "    # equation, using the expression for S_k here. Not sure why the discrepency is here.\n",
        "    \n",
        "    nu_1 = M.T @ PHI.T @ jnp.linalg.solve(S_1, zs[0])\n",
        "    Q_1  = M.T @ PHI.T @ jnp.linalg.solve(S_1, PHI) @ M\n",
        "\n",
        "    first_elt = (A_1, b_1, C_1, nu_1, Q_1)\n",
        "\n",
        "    @jax.jit\n",
        "    def get_element(z_k):\n",
        "                \n",
        "        S_k = PHI @ S2_eta @ PHI.T + S2_eps\n",
        "                \n",
        "        D_k = (jsc.linalg.solve(S_k, PHI @ S2_eta)).T\n",
        "\n",
        "        imdp = (jnp.eye(r) - D_k @ PHI)\n",
        "        \n",
        "        A_k = imdp @ M\n",
        "        b_k = D_k @ z_k\n",
        "        \n",
        "        C_k = imdp @ S2_eta\n",
        "\n",
        "        nu_k = M.T @ PHI.T @ jsc.linalg.solve(S_k, z_k)\n",
        "        Q_k = M.T @ PHI.T @ jsc.linalg.solve(S_k, PHI @ M)\n",
        "    \n",
        "        return (A_k, b_k, C_k, nu_k, Q_k)\n",
        "\n",
        "    elts = jax.vmap(get_element)(zs[1:])\n",
        "\n",
        "    all_elts = jax.tree.map(lambda f, e: jnp.concatenate([f[None, :], e]), first_elt, elts)\n",
        "\n",
        "    @jax.vmap\n",
        "    def compose(elt_i, elt_j):\n",
        "        \n",
        "        A_i, b_i, C_i, nu_i, Q_i = elt_i\n",
        "        A_j, b_j, C_j, nu_j, Q_j = elt_j\n",
        "\n",
        "        I = jnp.eye(r)\n",
        "        \n",
        "        ipcq = I + C_i @ Q_j\n",
        "        ipqc = I + Q_j @ C_i\n",
        "\n",
        "        # lots of cho solves, can be simplifies. \n",
        "        A_ij = A_j @ jsc.linalg.solve(ipcq, A_i)\n",
        "        b_ij = A_j @ jsc.linalg.solve(ipcq, (b_i + C_i @ nu_j)) + b_j\n",
        "        C_ij = A_j @ jsc.linalg.solve(ipcq, C_i @ A_j.T) + C_j\n",
        "        nu_ij = A_i.T @ jsc.linalg.solve(ipqc, nu_j - Q_j@b_i) + nu_i\n",
        "        Q_ij = A_i.T @ jsc.linalg.solve(ipqc, Q_j @ A_i) + Q_i\n",
        "        \n",
        "        return (A_ij, b_ij, C_ij, nu_ij, Q_ij)\n",
        "    \n",
        "    final_elts = jl.associative_scan(compose, all_elts)\n",
        "\n",
        "    ms = final_elts[1]\n",
        "    Ps = final_elts[2]\n",
        "\n",
        "    nu, Q = final_elts[3][-1], final_elts[4][-1]\n",
        "\n",
        "    @jax.jit\n",
        "    def get_ll(z, m, P):\n",
        "\n",
        "        m_pred = M @ m\n",
        "        P_pred = M @ P @ M.T + S2_eta\n",
        "\n",
        "        e = z - PHI @ m_pred\n",
        "        S = PHI @ P_pred @ PHI.T + S2_eps\n",
        "        \n",
        "        cholS = jnp.linalg.cholesky(S)\n",
        "        z = st(cholS, e, lower=True)\n",
        "        ll = (\n",
        "            - jnp.sum(jnp.log(jnp.diag(cholS)))\n",
        "            - 0.5 * jnp.dot(z, z)\n",
        "            - 0.5 * nobs * jnp.log(2 * jnp.pi)\n",
        "        )\n",
        "\n",
        "        return ll\n",
        "    \n",
        "    ll = jnp.sum(jax.vmap(get_ll)(zs,\n",
        "                                  jnp.concatenate([m_0[None, :], ms])[:-1],\n",
        "                                  jnp.concatenate([P_0[None, :, :], Ps])[:-1]))\n",
        "\n",
        "\n",
        "    \n",
        "    filt_results = {\"ll\": ll,\n",
        "                    \"ms\": ms,\n",
        "                    \"Ps\": Ps}\n",
        "\n",
        "    return filt_results"
      ],
      "id": "7f095456",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "filt_results_pkal = pkalman_filter(m_0, P_0, M, PHI, S2_eta, S2_eps, zs)"
      ],
      "id": "84842d45",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Square-Root Parallel Filter\n"
      ],
      "id": "adc90748"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "@jax.jit\n",
        "def psqrt_filter(m_0, U_0, M, PHI, S2_eta, S2_eps, zs):\n",
        "    \n",
        "    r = m_0.shape[0]\n",
        "    nobs = zs.shape[1]\n",
        "    Ir = jnp.eye(r)\n",
        "    In = jnp.eye(nobs)\n",
        "\n",
        "    S_eta = jnp.linalg.cholesky(S2_eta, upper=True)\n",
        "    S_eps = jnp.linalg.cholesky(S2_eps, upper=True)\n",
        "    \n",
        "    m1pred = M @ m_0\n",
        "    U1pred = qr_R(U_0 @ M.T, S_eta)\n",
        "\n",
        "    #S_1 =  PHI @ P1pred @ PHI.T + S2_eps\n",
        "    W_1 = qr_R(U1pred@PHI.T, S_eps)\n",
        "\n",
        "    # cholS = jsc.linalg.cho_factor(S_1)\n",
        "    #D_1 = (jsc.linalg.cho_solve(cholS, PHI_tree[0])@P1pred.T).T\n",
        "    #D_1 = (jnp.linalg.solve(S_1, PHI @ P1pred)).T\n",
        "\n",
        "    # tentatively correct\n",
        "    D_1 = (st(W_1.T, (st(W_1, PHI, lower=True)), lower=False) @ U1pred @ U1pred.T).T\n",
        "    \n",
        "    A_1  = jnp.zeros((r,r))\n",
        "    b_1  = m1pred + D_1 @ (zs[0] - PHI @ m1pred)\n",
        "    #C_1  = P1pred - D_1 @ S_1 @ D_1.T\n",
        "\n",
        "    # tentatively named\n",
        "    U_1 = qr_R(U1pred@(Ir-D_1@PHI).T, S_eps @ D_1.T)\n",
        "\n",
        "    # this is how it is in the paper. Adrien Corenflos has a slighlty different\n",
        "    # equation, using the expression for S_k here. Not sure why the discrepency is here.\n",
        "    \n",
        "    #nu_1 = M.T @ PHI.T @ jnp.linalg.solve(S_1, zs[0])\n",
        "    nu_1 = M.T @ PHI.T @ st(W_1.T, (st(W_1, zs[0], lower=True)), lower=False)\n",
        "    #Q_1  = M.T @ PHI.T @ jnp.linalg.solve(W_1.T@W_1, PHI) @ M\n",
        "    #R_1 = jnp.linalg.qr(st(W_1, PHI, lower=True) @ M, mode='r')\n",
        "    R_1 = qr_R(st(W_1, PHI, lower=True), jnp.zeros((r,r)))\n",
        "    #R_1 =  jnp.linalg.cholesky(M.T @ PHI.T @ st(W_1.T, (st(W_1, PHI, lower=True)), lower=False)@M + 0.0001*jnp.eye(r))\n",
        "\n",
        "    first_elt = (A_1, b_1, U_1, nu_1, R_1)\n",
        "\n",
        "    @jax.jit\n",
        "    def get_element(z_k):\n",
        "                \n",
        "        #S_k = PHI @ S2_eta @ PHI.T + S2_eps\n",
        "        W_k = qr_R(S_eta @PHI.T, S_eps)\n",
        "                \n",
        "        #D_k = (jnp.linalg.solve(S_k, PHI @ S2_eta)).T\n",
        "        D_k = (st(W_k.T, (st(W_k, PHI, lower=True)), lower=False) @ S2_eta).T\n",
        "        \n",
        "        imdp = (Ir - D_k @ PHI)\n",
        "        \n",
        "        A_k = imdp @ M\n",
        "        b_k = D_k @ z_k\n",
        "        \n",
        "        U_k = qr_R(S_eta@imdp.T, S_eps@D_k.T)\n",
        "\n",
        "        #nu_k = M.T @ PHI.T @ jnp.linalg.solve(S_k, z_k)\n",
        "        nu_k = M.T @ PHI.T @ st(W_k.T, (st(W_k, z_k, lower=True)), lower=False)\n",
        "        #Q_k = M.T @ PHI.T @ jnp.linalg.solve(S_k, PHI @ M)\n",
        "        #R_k = jnp.linalg.qr(st(W_k, PHI, lower=True) @ M, mode='r')\n",
        "        #R_k = jnp.linalg.cholesky(M.T @ PHI.T @ st(W_k.T, (st(W_k, PHI@M, lower=True)), lower=False) + 0.0001*jnp.eye(r))\n",
        "        R_k = qr_R(st(W_k, PHI, lower=True) @ M, jnp.zeros((r,r)))\n",
        "        \n",
        "        return (A_k, b_k, U_k, nu_k, R_k)\n",
        "\n",
        "    elts = jax.vmap(get_element)(zs[1:])\n",
        "\n",
        "    all_elts = jax.tree.map(lambda f, e: jnp.concatenate([f[None, :], e]), first_elt, elts)\n",
        "\n",
        "    @jax.vmap\n",
        "    def compose(elt_i, elt_j):\n",
        "        \n",
        "        A_i, b_i, U_i, nu_i, R_i = elt_i\n",
        "        A_j, b_j, U_j, nu_j, R_j = elt_j\n",
        "        \n",
        "        #ipcq = Ir + C_i @ Q_j\n",
        "\n",
        "        C_i = U_i.T@U_i\n",
        "        Q_j = R_j.T@R_j\n",
        "        \n",
        "        ipcq = Ir + C_i@Q_j\n",
        "        ipqc = Ir + Q_j@C_i\n",
        "\n",
        "        sipcqc = jnp.linalg.cholesky(ipcq@C_i)\n",
        "        sipqcq = jnp.linalg.cholesky(ipqc@Q_j)\n",
        "\n",
        "        # can be simplified with cho solves?\n",
        "        A_ij = A_j @ jnp.linalg.solve(ipcq, A_i)\n",
        "        b_ij = A_j @ jnp.linalg.solve(ipcq, (b_i + C_i @ nu_j)) + b_j\n",
        "        #C_ij = A_j @ jnp.linalg.solve(ipcq, C_i @ A_j.T) + C_j\n",
        "        U_ij = qr_R(sipcqc @ A_j.T, U_j) \n",
        "        nu_ij = A_i.T @ jnp.linalg.solve(ipqc, nu_j - Q_j@b_i) + nu_i\n",
        "\n",
        "        R_ij = qr_R(sipqcq @ A_i, R_i)\n",
        "        \n",
        "        return (A_ij, b_ij, U_ij, nu_ij, R_ij)\n",
        "    \n",
        "    final_elts = jl.associative_scan(compose, all_elts)\n",
        "\n",
        "    ms = final_elts[1]\n",
        "    Us = final_elts[2]\n",
        "\n",
        "    nu, R = final_elts[3][-1], final_elts[4][-1]\n",
        "\n",
        "    @jax.jit\n",
        "    def get_ll(z, m, U):\n",
        "\n",
        "        m_pred = M @ m\n",
        "        # caution!\n",
        "        U_pred = qr_R(U @ M.T, S_eta)\n",
        "\n",
        "        e = z - PHI @ m_pred\n",
        "        Ui_t = qr_R(U_pred @ PHI.T, S_eps)\n",
        "        \n",
        "        s = st(Ui_t, e, lower=True)\n",
        "        \n",
        "        ll = (\n",
        "            - jnp.sum(jnp.log(jnp.diag(Ui_t)))\n",
        "            - 0.5 * jnp.dot(s, s)\n",
        "            - 0.5 * nobs * jnp.log(2 * jnp.pi) \n",
        "        )\n",
        "\n",
        "        return ll\n",
        "    \n",
        "    ll = jnp.sum(jax.vmap(get_ll)(zs,\n",
        "                                  jnp.concatenate([m_0[None, :], ms])[:-1],\n",
        "                                  jnp.concatenate([U_0[None, :, :], Us])[:-1]))\n",
        "\n",
        "\n",
        "    \n",
        "    filt_results = {\"ll\": ll,\n",
        "                    \"ms\": ms,\n",
        "                    \"Us\": Us}\n",
        "\n",
        "    return filt_results"
      ],
      "id": "d9ac3148",
      "execution_count": null,
      "outputs": []
    },
