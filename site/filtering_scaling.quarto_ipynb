        "    line=dict(color='rgba(0,0,0,0)'),\n",
        "    showlegend=True,\n",
        "    name='±1 std deviation'\n",
        "))\n",
        "\n",
        "\n",
        "fig.update_layout(\n",
        "    title='Tracking Model',\n",
        "    xaxis_title='X',\n",
        "    yaxis_title='Y',\n",
        "    legend=dict(x=0.02, y=0.98),\n",
        "    width=700,\n",
        "    height=500,\n",
        "    paper_bgcolor=cat[\"base\"],\n",
        "    plot_bgcolor=cat[\"base\"],\n",
        "    font=dict(color=cat[\"text\"], size=16),\n",
        ")\n",
        "\n",
        "\n",
        "fig.show()"
      ],
      "id": "3fbf5877",
