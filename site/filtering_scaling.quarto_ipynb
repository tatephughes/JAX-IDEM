    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Observation dimension vs. compute time"
      ],
      "id": "35aaff91"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: true\n",
        "#| output: false\n",
        "jit_kal   = lambda tup: kalman_filter(m_0, P_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_inf   = lambda tup: information_filter(nu_0, Q_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_sqrt  = lambda tup: sqrt_filter(m_0, U_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_sqinf = lambda tup: sqinf_filter(nu_0, R_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "jit_pkal  = lambda tup: pkalman_filter(m_0, P_0, tup[0], tup[1], tup[2], tup[3], tup[4])['ll']\n",
        "\n",
        "n_vals = range(10, 200, 10)\n",
        "#n_vals = [10,20]\n",
        "nreps = 20\n",
        "\n",
        "results = {\n",
        "    \"Kalman\": [],\n",
        "    \"Information\": [],\n",
        "#    \"sqrt\": [],\n",
        "#    \"sqinf\": [],\n",
        "#    \"pkal\": []\n",
        "}\n",
        "\n",
        "for n in n_vals:\n",
        "    zs_cut = zs[:, :n]\n",
        "    S2_eps_cut = S2_eps[:n, :n]\n",
        "    PHI_cut = PHI[:n, :]\n",
        "    inp_tree = (M, PHI_cut, S2_eta, S2_eps_cut, zs_cut)\n",
        "    results[\"Kalman\"].append(time_jit(key, jit_kal, inp_tree, n=nreps).average_time * 1000)\n",
        "    results[\"Information\"].append(time_jit(key, jit_inf, inp_tree, n=nreps).average_time * 1000)\n",
        "#    results[\"sqrt\"].append(time_jit(key, jit_sqrt, inp_tree, n=nreps).average_time * 1000)\n",
        "#    results[\"sqinf\"].append(time_jit(key, jit_sqinf, inp_tree, n=nreps).average_time * 1000)\n",
        "#    results[\"pkal\"].append(time_jit(key, jit_pkal, inp_tree, n=nreps).average_time * 1000)\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "for method, times in results.items():\n",
        "    if method == \"Kalman\":\n",
        "        color = cat[\"red\"]\n",
        "    if method == \"Information\":\n",
        "        color = cat[\"blue\"]\n",
        "    fig.add_trace(go.Scatter(x=list(n_vals), y=times,\n",
        "                             mode='lines',\n",
        "                             name=method,\n",
        "                             line=dict(color=color, width=2)))\n",
        "\n",
        "fig.update_layout(\n",
        "    title=\"Average Execution Time vs number of observations\",\n",
        "    xaxis_title=\"n (Observation Dimension)\",\n",
        "    yaxis_title=\"Average Time (ms)\",\n",
        "    legend_title=\"Filter Method\",\n",
        "    margin=dict(t=40)\n",
        ")\n",
        "\n",
        "apply_catppuccin_mocha(fig, fontsize=20)"
      ],
