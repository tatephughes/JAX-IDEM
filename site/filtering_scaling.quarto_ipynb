        "\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=alphas[:50, 0],\n",
        "    y=alphas[:50, 1],\n",
        "    mode='lines+markers',\n",
        "    name='Process',\n",
        "    line=dict(color=cat[\"blue\"]),\n",
        "    marker=dict(size=6)\n",
        "))\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
        "    x=zs[:50, 0],\n",
        "    y=zs[:50, 1],\n",
        "    mode='lines+markers',\n",
        "    name='Observations',\n",
        "    line=dict(color=cat[\"red\"], dash='dot', width=1),\n",
        "    marker=dict(\n",
        "        symbol='cross',\n",
        "        color=cat[\"red\"],\n",
        "        size=8,\n",
        "    )\n",
        "))\n",
        "\n",
        "fig.update_layout(\n",
        "    title='Tracking Model',\n",
        "    xaxis_title='X',\n",
        "    yaxis_title='Y',\n",
        "    legend=dict(x=0.02, y=0.98),\n",
        "    width=700,\n",
        "    height=500,\n",
        "    paper_bgcolor=cat[\"base\"],\n",
        "    plot_bgcolor=cat[\"base\"],\n",
        "    font=dict(color=cat[\"text\"], size=16),\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "2fa261e3",
      "execution_count": null,
      "outputs": []
