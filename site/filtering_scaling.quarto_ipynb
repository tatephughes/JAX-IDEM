        "\n",
        "ms = filt_results_kal['ms']\n",
        "Ps = filt_results_kal['Ps']\n",
        "\n",
        "m_x, m_y = ms[:50, 0], ms[:50, 1]\n",
        "s2_x, s2_y = Ps[:50, 0,0], Ps[:50, 1,1]\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "fig = go.Figure()\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "fig.add_trace(go.Scatter(\n",
