        "# IDEM\n",
        "\n",
        "## IDEM"
      ],
      "id": "dda279dd"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: true\n",
        "\n",
        "process_basis = utils.place_basis(min_knot_num = 5, nres=1, aperture = 1.0) \n",
        "\n",
        "covariate_labels=['Intercept', 'x', 'y']\n",
        "beta = jnp.zeros(len(covariate_labels)) \n",
        "\n",
        "process_grid = utils.create_grid(jnp.array([[0, 1], [0, 1]]), jnp.array([41, 41]))\n",
        "process_basis = utils.place_basis()\n",
        "\n",
        "K_basis = (\n",
        "    utils.place_basis(nres=1, min_knot_num=1, basis_fun=lambda s, r: 1),\n",
        "    utils.place_basis(nres=1, min_knot_num=1, basis_fun=lambda s, r: 1),\n",
        "    utils.place_basis(nres=1, min_knot_num=1, basis_fun=lambda s, r: 1),\n",
        "    utils.place_basis(nres=1, min_knot_num=1, basis_fun=lambda s, r: 1),\n",
        ")\n",
        "k = (\n",
        "    jnp.array([150.0]),\n",
        "    jnp.array([0.002]),\n",
        "    jnp.array([-0.1]),\n",
        "    jnp.array([0.1]),\n",
        ")\n",
        "kernel = idem.param_exp_kernel(K_basis, k)\n",
        "\n",
        "nobs = 1000\n",
        "\n",
        "coords = master_coords[:nobs, :]\n",
        "\n",
        "nbasis = process_basis.nbasis\n",
        "S2_eta = 0.05**2 * jnp.eye(nbasis)\n",
        "S2_eps = 0.1**2 * jnp.eye(nobs)\n",
        "\n",
        "model = idem.Model(\n",
        "    process_basis=process_basis,\n",
        "    kernel=kernel,\n",
        "    process_grid=process_grid,\n",
        "    sigma2_eta=S2_eta,\n",
        "    sigma2_eps=S2_eps,\n",
        "    beta=beta,\n",
        "    covariate_labels=covariate_labels,\n",
        ")\n",
        "\n",
        "M = model.M\n",
        "PHI = model.process_basis.mfun(coords)\n",
        "S2_eta = model.sigma2_eta\n",
        "S2_eps = model.sigma2_eps\n",
        "\n",
        "S_eta = jnp.linalg.cholesky(S2_eta)\n",
        "S_eps = jnp.linalg.cholesky(S2_eps)\n",
        "\n",
        "alpha_0 = jnp.zeros(nbasis).at[74].set(5.)\n",
        "alphas = [alpha_0]\n",
        "zs = []\n",
        "\n",
        "T = 9\n",
        "for i in range(T):\n",
        "    alphas.append(M @ alphas[-1] + S_eta @ inn[i, :nbasis])\n",
        "    zs.append(PHI @ alphas[-1] + S_eps @ inn[i, nbasis:nbasis + nobs])\n",
        "\n",
        "alphas = jnp.array(alphas[1:])\n",
        "zs = jnp.array(zs)\n",
        "\n",
        "\n",
        "n = 100\n",
        "coords_sample = coords[:n, :]\n",
        "\n",
        "times = jnp.repeat(jnp.arange(1, T + 1), coords_sample.shape[0])\n",
        "rep_coords = jnp.tile(coords_sample, (T, 1))\n",
        "\n",
        "process_data = idem.basis_params_to_st_data(alphas, process_basis, process_grid, times=None)\n",
        "obs_data = utils.st_data(x = rep_coords[:, 0], y = rep_coords[:, 1], times = times, z = jnp.concatenate(list(zs[:,:n])))\n",
        "\n",
        "process_data.save_plot(\"figure/simple_idem_process.png\")\n",
        "obs_data.save_plot(\"figure/simple_idem_obs.png\")\n",
        "\n",
        "frames = plotly_st_scat(obs_data)\n",
        "fig =  make_st_fig(frames, spacing=[0.05, 0.08])\n",
        "fig.update_layout(height=800)\n",
        "apply_catppuccin_mocha(fig, fontsize=20)\n",
        "fig.update_xaxes(title_text=None, showticklabels=False)\n",
        "fig.update_yaxes(title_text=None, showticklabels=False)\n",
        "fig.write_image(\n",
        "    \"figure/obs_data.pdf\",\n",
        "    scale=2             # multiplier for crisper text & lines\n",
        ")\n",
        "fig.show()"
      ],
